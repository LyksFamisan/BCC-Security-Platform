{
  "expo": {
    "name": "BCC Guard",
    "slug": "bcc-guard",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      "package": "com.bcc.demo.guard",
      "adaptiveIcon": {
        "foregroundImage": "./assets/BCC_logo.jpg",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose an incident evidence photo.",
          "microphonePermission": false,
          "cameraPermission": "Take a photo for an incident report."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Verify your location for duty attendance and GPS check-ins."
        }
      ]
    ],
    "userInterfaceStyle": "light",
    "backgroundColor": "#f4fbff",
    "icon": "./assets/BCC_logo.jpg",
    "ios": {
      "bundleIdentifier": "com.bcc.demo.guard"
    },
    "scheme": "bcc-guard"
  }
}
