{
  "expo": {
    "name": "BCC Guard",
    "slug": "bcc-guard",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      "package": "com.bcc.demo.guard",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#102B35"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose an incident evidence photo.",
          "microphonePermission": false
        }
      ]
    ],
    "userInterfaceStyle": "light",
    "backgroundColor": "#102B35",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.bcc.demo.guard"
    },
    "scheme": "bcc-guard"
  }
}
