DATABASE_URL=postgresql://bcc:bcc_local_only@localhost:5432/bcc
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3001
WEB_ORIGINS=http://localhost:8443
UPLOAD_DIR=./uploads
DEMO_PASSWORD=choose-a-local-demo-password

# Optional: 32 random bytes encoded as base64; retain keys separately from backups.
PHOTO_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=./backups
# Set true only behind correctly configured HTTPS. Match the actual trusted proxy hops.
REQUIRE_HTTPS=false
TRUST_PROXY_HOPS=
