{
  "installCommand": "npm --prefix web ci && npm --prefix backend ci --omit=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "feat/connected-security-apps": false,
      "feat/tor-operational-workflows": false
    }
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{backend/src/**,backend/node_modules/pdfkit/js/data/**}"
    }
  },
  "regions": [
    "sin1"
  ]
}
