{
  "installCommand": "npm --prefix web ci",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "feat/connected-security-apps": false,
      "feat/tor-operational-workflows": false
    }
  }
}
